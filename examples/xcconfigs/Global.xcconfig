// Generic identity settings shared by app and extension targets.
DEVELOPMENT_TEAM[config=Debug] = AAAAA11111
DEVELOPMENT_TEAM[config=Release] = AAAAA11111

DEVELOPMENT_TEAM_SUFFIX[config=Debug] = .$(DEVELOPMENT_TEAM)
DEVELOPMENT_TEAM_SUFFIX[config=Release] =

BASE_BUNDLE_IDENTIFIER = com.example.myapp$(DEVELOPMENT_TEAM_SUFFIX)
APP_GROUP_IDENTIFIER = group.com.example.myapp$(DEVELOPMENT_TEAM_SUFFIX)
